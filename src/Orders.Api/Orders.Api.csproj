<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orders.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Generación del documento OpenAPI en tiempo de build.
      El archivo resultante (openapi/orders.json) se versiona en el repo y Terraform lo
      importa en APIM con file(): así el despliegue no depende de que el backend esté vivo.
      En el contenedor no hace falta regenerarlo, por eso se desactiva con -p:GenerateOpenApi=false.
    -->
    <GenerateOpenApi Condition="'$(GenerateOpenApi)' == ''">true</GenerateOpenApi>
    <OpenApiGenerateDocuments>$(GenerateOpenApi)</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>$(GenerateOpenApi)</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name orders --openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
